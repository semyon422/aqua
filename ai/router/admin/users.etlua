<h2>Users</h2>
<table>
<tr><th>id</th><th>name</th><th>key hint</th><th>grants</th><th>disabled</th><th>concurrency / RPM</th></tr>
<% for _, user in ipairs(users) do %>
<tr>
<td><%= user.id %></td><td><%= user.name %></td>
<td><code>…<%= user.key_hint %></code></td>
<td><%= table.concat(grants_by_user[user.id], ", ") %></td>
<td><%= user.disabled and "yes" or "no" %></td>
<td><%= user.max_concurrency or "default" %> / <%= user.max_rpm or "default" %></td>
</tr>
<% end %>
</table>
