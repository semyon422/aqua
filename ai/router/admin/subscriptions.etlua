<h2>Subscriptions</h2>
<table>
<tr><th>id</th><th>name</th><th>kind</th><th>priority</th><th>enabled</th><th>models / redirects</th><th>thresholds</th><th>5h / weekly</th><th>OpenAI login</th></tr>
<% for _, row in ipairs(rows) do %>
<%
local limits = row.limits
local windows = window_states[row.id]
local function fmt(window)
	local w = windows and windows[window]
	if not w then return "—" end
	return string.format("%s%% (%s)", tostring(w.used_percent or "?"), w.source)
end
%>
<tr><td><%= row.id %></td><td><%= row.name %></td><td><%= row.kind %></td>
<td><%= row.priority %></td><td><%= row.enabled and "yes" or "no" %></td>
<td><%= table.concat(row.config.models, ", ") %>
<% for source, target in pairs(row.config.model_redirects or {}) do %><div><%= source %> → <%= target %></div><% end %></td>
<td><%= limits.five_hour_threshold and ("5h ≥ " .. limits.five_hour_threshold .. "%") or "—" %>
<%= limits.weekly_threshold and (" / weekly ≥ " .. limits.weekly_threshold .. "%") or "" %></td>
<td><%= fmt("five_hour") %> / <%= fmt("weekly") %></td>
<td><%= login_states[row.id] and login_states[row.id].status or "—" %></td></tr>
<% end %>
</table>
