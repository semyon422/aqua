<h2>Live subscription status</h2>
<table>
<tr><th>subscription</th><th>kind</th><th>enabled</th><th>window</th><th>fill</th><th>used / quota</th><th>source</th><th>age</th><th>resets at</th></tr>
<% for _, sub in ipairs(subscriptions) do %>
<%
local windows = windows[sub.id] or {}
local names = {"five_hour", "weekly"}
for _, window in ipairs(names) do
	local w = windows[window]
%>
<tr>
<% if window == "five_hour" then %>
<td rowspan="2"><%= sub.name %></td>
<td rowspan="2"><%= sub.kind %></td>
<td rowspan="2"><%= sub.enabled and "yes" or "no" %></td>
<% end %>
<td><%= window %></td>
<% if w then %>
<td><%= w.used_percent and string.format("%.1f%%", w.used_percent) or "—" %></td>
<td><%= w.used_tokens and (w.used_tokens .. " / " .. tostring(w.quota_tokens or "?")) or "—" %></td>
<td><%= w.source %></td>
<td><%= string.format("%ds ago", math.floor(now - w.updated_at)) %></td>
<td><%= w.reset_at and os.date("%Y-%m-%d %H:%M", w.reset_at) or "—" %></td>
<% else %>
<td>—</td><td>—</td><td><%= sub.usage_source[window] or "?" %></td><td>—</td><td>—</td>
<% end %>
</tr>
<% end %>
<% end %>
</table>
<p class="muted">Quotas are informational. Requests always use the explicitly selected subscription, without automatic switching.</p>
