<form class="filters" method="get" action="/admin/requests">
<label>User<input name="user" value="<%= filters.user or '' %>" maxlength="193"></label>
<label>Model<input name="model" value="<%= filters.model or '' %>" maxlength="193"></label>
<label>Channel<input name="channel" value="<%= filters.channel or '' %>" maxlength="193"></label>
<label>Result<select name="outcome">
<option value="">All</option>
<option value="success"<% if filters.outcome == "success" then %> selected<% end %>>Success</option>
<option value="error"<% if filters.outcome == "error" then %> selected<% end %>>Error</option>
</select></label><button type="submit">Filter</button> <a href="/admin/requests">Reset</a>
</form>
<p class="muted">Newest completed requests first. Exact-match filters. Last <%= retention_days %> days, up to <%= max_rows %> entries. No prompts or responses are stored.</p>
<div class="scroll"><table>
<tr><th>ID</th><th>Time</th><th>User</th><th>Model</th><th>Channel</th><th>Upstream model</th><th>Protocol</th><th>Stream</th><th>Result</th><th>Duration</th><th>Input</th><th>Cache</th><th>Output</th></tr>
<% for _, row in ipairs(rows) do %>
<tr><td><%= row.id %></td><td><%= os.date("%Y-%m-%d %H:%M:%S", row.created_at) %></td>
<td><%= row.user %></td><td><%= row.model ~= "" and row.model or "—" %></td>
<td><%= row.channel ~= "" and row.channel or "—" %></td><td><%= row.upstream_model ~= "" and row.upstream_model or "—" %></td>
<td><%= row.protocol %></td><td><%= row.stream and "yes" or "no" %></td>
<td<% if row.status >= 400 then %> class="error"<% end %>><%= row.status %></td>
<td><%= string.format("%.3fs", row.duration_ms / 1000) %></td>
<% for _, key in ipairs({"input_tokens", "cached_input_tokens", "output_tokens"}) do %>
<td><%= row.estimated and "~" or "" %><%= row[key] %></td>
<% end %></tr>
<% end %>
<% if #rows == 0 then %><tr><td colspan="13" class="muted">No requests found.</td></tr><% end %>
</table></div>
<p><a href="/admin/requests">Latest</a><% if older_url then %> · <a href="<%= older_url %>">Older →</a><% end %></p>
<p class="muted">Result is the logical outcome: stream failures may show 502 after HTTP 200; disconnected clients show 499. Token counts prefixed with ~ are estimates; cache tokens are included in input. Duration covers the full request, including streaming. Time uses the server timezone.</p>
