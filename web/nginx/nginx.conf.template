worker_processes 1;
error_log <%= error_log_path or "logs/error.log" %> notice;
pid <%= pid_path or "logs/nginx.pid" %>;

env LJ_ROOT;
env OR_ROOT;
env NGINX_CONFIG_PATH;
env RIZU_COMPUTE_VERSION;

events {
	worker_connections 1024;
}

http {
	access_log <%= access_log_path or "logs/access.log" %>;
	include <%= mime_types_path or "aqua/web/nginx/mime.types" %>;
	resolver 8.8.8.8 8.8.4.4 ipv6=off;

	client_body_temp_path <%= temp_path or "temp" %>/client_body;
	proxy_temp_path <%= temp_path or "temp" %>/proxy;
	fastcgi_temp_path <%= temp_path or "temp" %>/fastcgi;
	uwsgi_temp_path <%= temp_path or "temp" %>/uwsgi;
	scgi_temp_path <%= temp_path or "temp" %>/scgi;

	client_max_body_size <%= client_max_body_size %>;

	<% if shared_dicts then %>
		<% for name, size in pairs(shared_dicts) do %>
			lua_shared_dict <%= name %> <%= size %>;
		<% end %>
	<% end %>

	init_by_lua_block {
		require("aqua.env.openresty")
		local pkg = require("pkg")
		local c = require("web.nginx.config")

		for _, path in ipairs(c.package_path) do
			pkg.add(path)
		end
		for _, path in ipairs(c.package_cpath) do
			pkg.add(path)
		end
		pkg.export_lua()

		for _, name in ipairs(c.require) do
			require(name)
		end
	}

	init_worker_by_lua_block {
		local handler = require("web.nginx.config").handler
		local module = require(handler)
		if type(module) == "table" and module.init_worker then
			module.init_worker()
		end
	}

	server {
		listen <%= listen %>;
		lua_code_cache <%= lua_code_cache %>;

		location / {
			set $_url "";
			allow 127.0.0.1;
			deny all;
			default_type text/html;
			content_by_lua_block {
				require("web.nginx.content")()
			}
		}

		location /static/ {
			alias static/;
		}

		location /favicon.ico {
			alias static/favicon.ico;
		}
	}
}
